generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  HR
  TEAM_LEAD
  SERVER
  MEMBER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
}

enum PresenceState {
  IN
  OUT
  UNKNOWN
}

enum EventScope {
  COMPANY
  ROOM
}

enum EventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AudienceScope {
  GLOBAL
  ADMINS_ONLY
  SERVERS_AND_MEMBERS
  ROOM_SPECIFIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotState {
  AVAILABLE
  UNAVAILABLE
  PREFERRED
  BUSY
}

// -----------------------------------------------------------------------------
// Organization & Hierarchy
// -----------------------------------------------------------------------------
model Organization {
  id            String         @id @default(uuid())
  name          String
  slug          String         @unique
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  users         User[]
  rooms         Room[]
  subrooms      Subroom[]
  tasks         Task[]
  campaigns     TaskCampaign[]
  announcements Announcement[]
  events        Event[]
  auditEvents   AuditEvent[]
  roleAuditLogs RoleAuditLog[]
  attendanceRecords AttendanceRecord[]

  @@map("organizations")
}

model User {
  id                    String        @id @default(uuid())
  organizationId        String
  email                 String        @unique
  passwordHash          String
  name                  String
  role                  UserRole?
  accountStatus         AccountStatus @default(PENDING)
  status                UserStatus    @default(OFFLINE)
  title                 String?
  avatarUrl             String?
  capacityLimitHours    Int           @default(40)
  currentAllocatedHours Int           @default(0)
  roomId                String?
  subroomId             String?
  
  // Real Presence & Current Location Tracking (Separate from Permanent Room Assignment)
  presenceState         PresenceState @default(UNKNOWN)
  arrivedAt             DateTime?
  leftAt                DateTime?
  lastSeenAt            DateTime?     @default(now())
  currentLocationRoomId    String?
  currentLocationSubroomId String?
  currentLocationName      String?    // e.g. "B4", "Main Hall", "Cafeteria", "Outside"

  lastLoginAt           DateTime?
  version               Int           @default(1)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room                  Room?         @relation("RoomMembers", fields: [roomId], references: [id], onDelete: SetNull)
  subroom               Subroom?      @relation("SubroomMembers", fields: [subroomId], references: [id], onDelete: SetNull)
  ledRooms              Room[]        @relation("RoomLeadServer")

  assignedTasks         Task[]        @relation("TaskAssignee")
  createdTasks          Task[]        @relation("TaskCreator")
  createdCampaigns      TaskCampaign[] @relation("CampaignCreator")
  taskComments          TaskComment[] @relation("CommentAuthor")
  announcements         Announcement[] @relation("AnnouncementAuthor")
  availabilitySlots     AvailabilitySlot[]
  eventsRequired        EventRequiredServer[]
  eventParticipations   EventParticipant[]
  auditEvents           AuditEvent[]
  roleAuditLogsTarget   RoleAuditLog[] @relation("TargetUserAudit")
  roleAuditLogsChanged  RoleAuditLog[] @relation("ActorAudit")
  passwordResetTokens   PasswordResetToken[]
  attendanceRecords     AttendanceRecord[]

  @@index([organizationId, role])
  @@index([organizationId, accountStatus])
  @@index([roomId, subroomId])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Rooms & Subrooms (Topology A-H, 1-8)
// -----------------------------------------------------------------------------
model Room {
  id             String       @id @default(uuid())
  organizationId String
  letter         String       // 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'
  name           String       // e.g. "Sector B — Core Operations"
  leadServerId   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadServer     User?        @relation("RoomLeadServer", fields: [leadServerId], references: [id], onDelete: SetNull)
  subrooms       Subroom[]
  members        User[]       @relation("RoomMembers")
  events         Event[]

  @@unique([organizationId, letter])
  @@map("rooms")
}

model Subroom {
  id             String       @id @default(uuid())
  organizationId String
  roomId         String
  code           String       // e.g. "B3"
  number         Int          // 1 to 8
  memberCapacity Int          @default(2)
  serverSeatCount Int         @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  members        User[]       @relation("SubroomMembers")
  events         Event[]

  @@unique([roomId, number])
  @@unique([organizationId, code])
  @@map("subrooms")
}

// -----------------------------------------------------------------------------
// Multi-Scope Events (Company-Wide & Room-Specific)
// -----------------------------------------------------------------------------
model Event {
  id                   String                @id @default(uuid())
  organizationId       String
  title                String
  description          String?
  scope                EventScope            @default(ROOM)
  roomId               String?               // Nullable for COMPANY events
  subroomId            String?               // Nullable for COMPANY events
  status               EventStatus           @default(ACTIVE)
  startTime            DateTime
  endTime              DateTime
  requiredServersCount Int?                  // Required supervisory servers

  organization         Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room                 Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  subroom              Subroom?              @relation(fields: [subroomId], references: [id], onDelete: SetNull)
  locations            EventLocation[]
  requiredServers      EventRequiredServer[]
  participants         EventParticipant[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([organizationId, status, startTime])
  @@map("events")
}

model EventLocation {
  id        String   @id @default(uuid())
  eventId   String
  name      String   // e.g. "Main Auditorium", "Room A", "Room B", "Remote"
  roomId    String?
  subroomId String?
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_locations")
}

model EventRequiredServer {
  id       String @id @default(uuid())
  eventId  String
  serverId String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  server   User   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([eventId, serverId])
  @@map("event_required_servers")
}

model EventParticipant {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_participants")
}

// -----------------------------------------------------------------------------
// Tasks, Campaigns & Comments
// -----------------------------------------------------------------------------
model TaskCampaign {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  targetRoom     String?
  dueDate        DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        User?        @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks          Task[]

  @@map("task_campaigns")
}

model Task {
  id             String        @id @default(uuid())
  taskIdDisplay  String?       @unique // e.g. "TSK-8421"
  organizationId String
  title          String
  description    String?
  status         TaskStatus    @default(DRAFT)
  priority       TaskPriority  @default(MEDIUM)
  estimatedHours Float         @default(8.0)
  allocatedHours Float         @default(0.0)
  dueDate        DateTime?
  assigneeId     String?
  creatorId      String?
  campaignId     String?
  tags           String[]      @default([])
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee       User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator        User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  campaign       TaskCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  comments       TaskComment[]

  @@index([organizationId, status, dueDate])
  @@index([assigneeId, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// -----------------------------------------------------------------------------
// Announcements
// -----------------------------------------------------------------------------
model Announcement {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  content        String
  status         AnnouncementStatus @default(PUBLISHED)
  scope          AudienceScope      @default(GLOBAL)
  targetRoom     String?
  authorId       String?
  pinned         Boolean            @default(false)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author         User?              @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, publishedAt])
  @@map("announcements")
}

// -----------------------------------------------------------------------------
// Availability (7-Day Weekly Matrix)
// -----------------------------------------------------------------------------
model AvailabilitySlot {
  id        String    @id @default(uuid())
  userId    String
  day       DayOfWeek
  hour      Int       // 0 to 23
  state     SlotState @default(AVAILABLE)
  taskId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, hour])
  @@index([userId, day])
  @@map("availability_slots")
}

// -----------------------------------------------------------------------------
// Audit Events
// -----------------------------------------------------------------------------
model AuditEvent {
  id             String       @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// Role Audit Logs
// -----------------------------------------------------------------------------
model RoleAuditLog {
  id             String       @id @default(uuid())
  organizationId String
  targetUserId   String
  changedById    String
  previousRole   UserRole?
  newRole        UserRole
  reason         String?
  createdAt      DateTime     @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser     User         @relation("TargetUserAudit", fields: [targetUserId], references: [id], onDelete: Cascade)
  changedBy      User         @relation("ActorAudit", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([organizationId, targetUserId])
  @@index([createdAt])
  @@map("role_audit_logs")
}

// -----------------------------------------------------------------------------
// Password Reset Tokens
// -----------------------------------------------------------------------------
model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// System Metadata
// -----------------------------------------------------------------------------
model SystemHealth {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_health")
}

// -----------------------------------------------------------------------------
// Attendance Records (Global Daily IN / OUT Attendance & Presence Logging)
// -----------------------------------------------------------------------------
model AttendanceRecord {
  id              String       @id @default(uuid())
  userId          String
  organizationId  String
  arrivedAt       DateTime
  leftAt          DateTime?
  durationSeconds Int?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, arrivedAt])
  @@index([organizationId, arrivedAt])
  @@index([userId, leftAt])
  @@map("attendance_records")
}

