generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------
enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEAM_LEAD
  SERVER
  MEMBER
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum UserStatus {
  ONLINE
  OFFLINE
  BUSY
  AWAY
}

enum PresenceState {
  IN
  OUT
  UNKNOWN
}

enum EventScope {
  COMPANY
  ROOM
}

enum EventStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  DRAFT
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  SUBMITTED
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskType {
  INDIVIDUAL
  TEAM
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  ARCHIVED
}

enum AudienceScope {
  GLOBAL
  ADMINS_ONLY
  SERVERS_AND_MEMBERS
  ROOM_SPECIFIC
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum SlotState {
  AVAILABLE
  UNAVAILABLE
  BUSY
}

// Organization Events (scheduled events with attendance polling) — distinct
// from the room/company supervisory `Event` model above.
enum OrgEventStatus {
  UPCOMING
  LIVE
  COMPLETED
  CANCELLED
}

enum EventResponseChoice {
  ATTENDING
  MAYBE
  NOT_ATTENDING
}

// -----------------------------------------------------------------------------
// Organization & Hierarchy
// -----------------------------------------------------------------------------
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  rooms             Room[]
  subrooms          Subroom[]
  tasks             Task[]
  campaigns         TaskCampaign[]
  announcements     Announcement[]
  events            Event[]
  orgEvents         OrganizationEvent[]
  auditEvents       AuditEvent[]
  roleAuditLogs     RoleAuditLog[]
  attendanceRecords AttendanceRecord[]

  @@map("organizations")
}

model User {
  id                    String        @id @default(uuid())
  organizationId        String
  email                 String        @unique
  passwordHash          String
  name                  String
  role                  UserRole?
  accountStatus         AccountStatus @default(PENDING)
  status                UserStatus    @default(OFFLINE)
  title                 String?
  avatarUrl             String?
  capacityLimitHours    Int           @default(40)
  currentAllocatedHours Int           @default(0)
  roomId                String?
  subroomId             String?

  // Real Presence & Current Location Tracking (Separate from Permanent Room Assignment)
  presenceState            PresenceState @default(UNKNOWN)
  arrivedAt                DateTime?
  leftAt                   DateTime?
  lastSeenAt               DateTime?     @default(now())
  currentLocationRoomId    String?
  currentLocationSubroomId String?
  currentLocationName      String? // e.g. "B4", "Main Hall", "Cafeteria", "Outside"

  lastLoginAt DateTime?
  version     Int       @default(1)

  // Set by "Mark all as read". Every notification-feed item created at or
  // before this instant reads as read, which makes the bulk action a single
  // -row update instead of a per-notification write, and keeps a notification
  // that arrives *later* correctly unread without any extra bookkeeping.
  notificationsReadAllAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room         Room?        @relation("RoomMembers", fields: [roomId], references: [id], onDelete: SetNull)
  subroom      Subroom?     @relation("SubroomMembers", fields: [subroomId], references: [id], onDelete: SetNull)
  ledRooms     Room[]       @relation("RoomLeadServer")

  assignedTasks        Task[]                      @relation("TaskAssignee")
  createdTasks         Task[]                      @relation("TaskCreator")
  createdCampaigns     TaskCampaign[]              @relation("CampaignCreator")
  taskComments         TaskComment[]               @relation("CommentAuthor")
  announcements        Announcement[]              @relation("AnnouncementAuthor")
  availabilitySlots    AvailabilitySlot[]
  availabilityOverrides AvailabilityOverride[]
  eventsRequired       EventRequiredServer[]
  eventParticipations  EventParticipant[]
  createdOrgEvents     OrganizationEvent[]         @relation("OrgEventCreator")
  orgEventResponses    OrganizationEventResponse[]
  auditEvents          AuditEvent[]
  roleAuditLogsTarget  RoleAuditLog[]              @relation("TargetUserAudit")
  roleAuditLogsChanged RoleAuditLog[]              @relation("ActorAudit")
  passwordResetTokens  PasswordResetToken[]
  attendanceRecords    AttendanceRecord[]
  notificationReads    NotificationRead[]

  @@index([organizationId, role])
  @@index([organizationId, accountStatus])
  @@index([roomId, subroomId])
  @@index([organizationId, presenceState])
  @@map("users")
}

// -----------------------------------------------------------------------------
// Rooms & Subrooms (Topology A-H, 1-8)
// -----------------------------------------------------------------------------
model Room {
  id             String   @id @default(uuid())
  organizationId String
  letter         String // 'A', 'B', 'C', 'D', 'E', 'F', 'G', 'H'
  name           String // e.g. "Sector B — Core Operations"
  leadServerId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadServer   User?        @relation("RoomLeadServer", fields: [leadServerId], references: [id], onDelete: SetNull)
  subrooms     Subroom[]
  members      User[]       @relation("RoomMembers")
  events       Event[]

  @@unique([organizationId, letter])
  @@map("rooms")
}

model Subroom {
  id              String   @id @default(uuid())
  organizationId  String
  roomId          String
  code            String // e.g. "B3"
  number          Int // 1 to 8
  memberCapacity  Int      @default(2)
  serverSeatCount Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room         Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  members      User[]       @relation("SubroomMembers")
  events       Event[]

  @@unique([roomId, number])
  @@unique([organizationId, code])
  @@map("subrooms")
}

// -----------------------------------------------------------------------------
// Multi-Scope Events (Company-Wide & Room-Specific)
// -----------------------------------------------------------------------------
model Event {
  id                   String      @id @default(uuid())
  organizationId       String
  title                String
  description          String?
  scope                EventScope  @default(ROOM)
  roomId               String? // Nullable for COMPANY events
  subroomId            String? // Nullable for COMPANY events
  status               EventStatus @default(ACTIVE)
  startTime            DateTime
  endTime              DateTime
  requiredServersCount Int? // Required supervisory servers

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  room            Room?                 @relation(fields: [roomId], references: [id], onDelete: SetNull)
  subroom         Subroom?              @relation(fields: [subroomId], references: [id], onDelete: SetNull)
  locations       EventLocation[]
  requiredServers EventRequiredServer[]
  participants    EventParticipant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, startTime])
  @@map("events")
}

model EventLocation {
  id        String  @id @default(uuid())
  eventId   String
  name      String // e.g. "Main Auditorium", "Room A", "Room B", "Remote"
  roomId    String?
  subroomId String?
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_locations")
}

model EventRequiredServer {
  id       String @id @default(uuid())
  eventId  String
  serverId String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  server   User   @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([eventId, serverId])
  @@map("event_required_servers")
}

model EventParticipant {
  id       String   @id @default(uuid())
  eventId  String
  userId   String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime @default(now())

  @@unique([eventId, userId])
  @@map("event_participants")
}

// -----------------------------------------------------------------------------
// Tasks, Campaigns & Comments
// -----------------------------------------------------------------------------
model TaskCampaign {
  id             String       @id @default(uuid())
  organizationId String
  title          String
  description    String?
  priority       TaskPriority @default(MEDIUM)
  targetRoom     String?
  dueDate        DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator      User?        @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks        Task[]

  @@map("task_campaigns")
}

model Task {
  id             String       @id @default(uuid())
  taskIdDisplay  String?      @unique // e.g. "TSK-8421"
  organizationId String
  title          String
  description    String?
  status         TaskStatus   @default(DRAFT)
  priority       TaskPriority @default(MEDIUM)
  taskType       TaskType     @default(INDIVIDUAL)
  teamSection    String?      // room letter, e.g. "B" — set only for TEAM tasks, including while unassigned
  parentTaskId   String?      // set on an INDIVIDUAL task created by splitting a TEAM task
  progress       Int          @default(0) // 0-100, authoritative
  estimatedHours Float        @default(8.0)
  allocatedHours Float        @default(0.0)
  dueDate        DateTime?
  assigneeId     String?
  creatorId      String?
  campaignId     String?
  tags           String[]     @default([])
  version        Int          @default(1)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignee     User?         @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  campaign     TaskCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  comments     TaskComment[]
  parentTask   Task?         @relation("TaskSplit", fields: [parentTaskId], references: [id], onDelete: SetNull)
  childTasks   Task[]        @relation("TaskSplit")

  @@index([organizationId, status, dueDate])
  @@index([assigneeId, status])
  @@index([organizationId, taskType, teamSection, status])
  @@index([organizationId, assigneeId, status])
  @@map("tasks")
}

model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("task_comments")
}

// -----------------------------------------------------------------------------
// Announcements
// -----------------------------------------------------------------------------
model Announcement {
  id             String             @id @default(uuid())
  organizationId String
  title          String
  content        String
  status         AnnouncementStatus @default(PUBLISHED)
  scope          AudienceScope      @default(GLOBAL)
  targetRoom     String?
  authorId       String?
  pinned         Boolean            @default(false)
  publishedAt    DateTime?
  scheduledFor   DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  author       User?        @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, publishedAt])
  @@index([organizationId, scope, targetRoom])
  @@map("announcements")
}

// -----------------------------------------------------------------------------
// Organization Events (scheduled events with availability polling & analytics)
// Separate domain from the room/company supervisory `Event` model — do not
// merge with Announcements or the supervisory Event model.
// -----------------------------------------------------------------------------
model OrganizationEvent {
  id             String         @id @default(uuid())
  organizationId String
  title          String
  description    String
  scheduledAt    DateTime
  scheduledEndAt DateTime
  completedAt    DateTime?
  status         OrgEventStatus @default(UPCOMING) // Authoritative only for CANCELLED; COMPLETED is derived from completedAt, everything else from scheduledAt/scheduledEndAt at read time
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?                       @relation("OrgEventCreator", fields: [createdById], references: [id], onDelete: SetNull)
  responses    OrganizationEventResponse[]

  @@index([organizationId, status, scheduledAt])
  @@map("organization_events")
}

model OrganizationEventResponse {
  id          String              @id @default(uuid())
  eventId     String
  userId      String
  response    EventResponseChoice
  respondedAt DateTime            @default(now())
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  event OrganizationEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, response])
  @@map("organization_event_responses")
}

// -----------------------------------------------------------------------------
// Availability (7-Day Weekly Matrix)
// -----------------------------------------------------------------------------
model AvailabilitySlot {
  id        String    @id @default(uuid())
  userId    String
  day       DayOfWeek
  hour      Int // 0 to 23
  state     SlotState @default(AVAILABLE)
  taskId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, hour])
  @@index([userId, day])
  @@map("availability_slots")
}

// Date-specific overrides — take precedence over the recurring AvailabilitySlot
// pattern for one exact calendar date, without altering the recurring baseline
// or any other date that shares the same weekday.
model AvailabilityOverride {
  id        String    @id @default(uuid())
  userId    String
  date      String // YYYY-MM-DD, naive local calendar date — same convention as AvailabilitySlot.hour
  hour      Int // 0 to 23
  state     SlotState @default(AVAILABLE)
  taskId    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, hour])
  @@index([userId, date])
  @@map("availability_overrides")
}

// -----------------------------------------------------------------------------
// Notification Read Receipts
//
// WorkGrid's notification feed is a projection over announcements and realtime
// domain events rather than a stored entity, so the only thing that needs
// persisting is which feed items a given person has already read. One row per
// (user, notification) pair the user has explicitly marked read; the bulk
// "mark all as read" action is handled by User.notificationsReadAllAt instead,
// so it never has to write one row per notification.
//
// A receipt row *is* the ownership record: it can only ever be created for the
// authenticated user's own id, so one user's read state can never touch
// another's.
// -----------------------------------------------------------------------------
model NotificationRead {
  id String @id @default(uuid())
  userId String
  // The feed-item id the client renders, e.g. "ann-<announcementId>" — stable
  // across reloads for announcement-derived items.
  notificationKey String
  readAt DateTime @default(now())
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Makes marking an already-read notification read again a no-op upsert
  // rather than a duplicate row.
  @@unique([userId, notificationKey])
  @@index([userId, readAt])
  @@map("notification_reads")
}

// -----------------------------------------------------------------------------
// Audit Events
// -----------------------------------------------------------------------------
model AuditEvent {
  id             String   @id @default(uuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  details        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_events")
}

// -----------------------------------------------------------------------------
// Role Audit Logs
// -----------------------------------------------------------------------------
model RoleAuditLog {
  id             String    @id @default(uuid())
  organizationId String
  targetUserId   String
  changedById    String
  previousRole   UserRole?
  newRole        UserRole
  reason         String?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targetUser   User         @relation("TargetUserAudit", fields: [targetUserId], references: [id], onDelete: Cascade)
  changedBy    User         @relation("ActorAudit", fields: [changedById], references: [id], onDelete: Cascade)

  @@index([organizationId, targetUserId])
  @@index([createdAt])
  @@map("role_audit_logs")
}

// -----------------------------------------------------------------------------
// Password Reset Tokens
// -----------------------------------------------------------------------------
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

// -----------------------------------------------------------------------------
// System Metadata
// -----------------------------------------------------------------------------
model SystemHealth {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("system_health")
}

// -----------------------------------------------------------------------------
// Attendance Records (Global Daily IN / OUT Attendance & Presence Logging)
// -----------------------------------------------------------------------------
model AttendanceRecord {
  id              String    @id @default(uuid())
  userId          String
  organizationId  String
  arrivedAt       DateTime
  leftAt          DateTime?
  durationSeconds Int?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, arrivedAt])
  @@index([organizationId, arrivedAt])
  @@index([userId, leftAt])
  @@map("attendance_records")
}
