# ==============================================================================
# Hierarchical Office Task Tracker - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Global / Environment Settings
# ------------------------------------------------------------------------------
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend Service Configuration
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW=60000

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
POSTGRES_USER=worktracker
POSTGRES_PASSWORD=worktracker_secure_pass
POSTGRES_DB=worktracker_db
POSTGRES_PORT=5432

# Connection string for Backend -> PostgreSQL (for local Docker Compose: host is 'postgres')
DATABASE_URL=postgresql://worktracker:worktracker_secure_pass@postgres:5432/worktracker_db?schema=public&connection_limit=20

# ------------------------------------------------------------------------------
# Redis Cache & Queue Configuration
# ------------------------------------------------------------------------------
REDIS_PORT=6379

# Connection string for Backend -> Redis (for local Docker Compose: host is 'redis')
REDIS_URL=redis://redis:6379

# ------------------------------------------------------------------------------
# Frontend Service Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000
